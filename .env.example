# Copy to .env.local. All of these are optional: by default the dev server
# proxies /v1 and /ws on its own origin, which is what LAN clients need.

# Listen on every interface (default) so phones/other machines can connect.
# ZIM_HOST=0.0.0.0

# Proxy targets for the API and the gate.
# ZIM_API=http://127.0.0.1:8080
# ZIM_WS=ws://127.0.0.1:3553

# Serve TLS with certs/dev-*.pem (WebRTC calls and PWA install need HTTPS).
# ZIM_HTTPS=1

# Only for a standalone deployment: point the browser straight at the gate.
# VITE_WS_ORIGIN=ws://127.0.0.1:3553
