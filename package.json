{
  "name": "zim-web",
  "version": "0.1.0",
  "private": true,
  "description": "ZIM instant messaging client: one React + TypeScript codebase for web, desktop (Tauri) and app (PWA/Capacitor)",
  "type": "module",
  "scripts": {
    "cert": "node scripts/dev-cert.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/ui.mjs"
  },
  "keywords": [
    "zim",
    "im",
    "react",
    "pwa",
    "tauri"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "livekit-client": "^2.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
