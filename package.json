{
  "name": "zim-web",
  "version": "0.1.0",
  "private": true,
  "description": "ZIM instant messaging client: one React + TypeScript codebase for web, desktop (Tauri) and app (PWA/Capacitor)",
  "type": "module",
  "scripts": {
    "cert": "node scripts/dev-cert.mjs",
    "dev": "vite",
    "dev:web": "vite",
    "dev:gateway": "vite --port 5290 --strictPort",
    "dev:pc": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:pc": "tauri build",
    "build:android": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "build:ios": "npm run build && cap sync ios",
    "sync:app": "npm run build && cap sync",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:platforms": "node scripts/check-platforms.mjs",
    "check": "npm run typecheck && npm run build && npm run check:platforms",
    "e2e": "node e2e/ui.mjs",
    "e2e:presence": "node e2e/presence-typing.mjs",
    "e2e:platforms": "node e2e/platforms.mjs",
    "e2e:friends": "node e2e/friends.mjs",
    "e2e:transport": "node e2e/transport.mjs"
  },
  "keywords": [
    "zim",
    "im",
    "react",
    "pwa",
    "tauri",
    "capacitor"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "livekit-client": "^2.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
